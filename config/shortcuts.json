{
  "channel": "shortcut",
  "codes": [
    "^F([1-9]|1[0-2])$",
    "^Key[A-Z]$",
    "^Digit[0-9]$",
    "^Numpad[0-9]$",
    "^Arrow(Up|Down|Left|Right)$",
    "^(Backquote|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Comma|Period|Slash|Space|Home|End|PageUp|PageDown|Insert|Delete|Backspace)$"
  ],
  "forbidden": [
    "Escape",
    "Tab",
    "Enter"
  ],
  "withoutModifier": [
    "^F([1-9]|1[0-2])$"
  ],
  "modifierCodes": [
    "ControlLeft",
    "ControlRight",
    "ShiftLeft",
    "ShiftRight",
    "AltLeft",
    "AltRight",
    "MetaLeft",
    "MetaRight",
    "OSLeft",
    "OSRight"
  ],
  "contextPattern": "^(global|module:[a-z][a-z0-9-]{0,63}|view:[a-z][a-z0-9-]{0,63})$",
  "stepPatterns": [
    "^open:(settings|hub|[a-z][a-z0-9-]{0,63})$",
    "^wait:[0-9]{1,5}$"
  ],
  "macroActions": [
    "quickSwitch",
    "moduleHub",
    "canvasMode",
    "globalSearch",
    "fullscreen"
  ],
  "maxMacros": 30,
  "maxSteps": 20,
  "maxNameLength": 40,
  "maxWaitMs": 5000,
  "maxContextBindings": 100,
  "contextPollMs": 400
}
