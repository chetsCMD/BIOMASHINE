{
  "name": "biomashine",
  "productName": "BIOMASHINE",
  "version": "1.1.0",
  "private": true,
  "description": "Personal Health and Lifestyle Dashboard",
  "author": "chetsCMD",
  "main": "src/main/main.js",
  "scripts": {
    "prepare-assets": "node scripts/prepare.js",
    "start": "node scripts/prepare.js && electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "postinstall": "electron-builder install-app-deps",
    "dist": "node scripts/prepare.js && electron-builder",
    "i18n": "node scripts/i18n.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chart.js": "3.8.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.biomashine.app",
    "productName": "BIOMASHINE",
    "files": [
      "src/**/*",
      "config/**/*",
      "migrations/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "portable",
        "zip",
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${os}.${ext}",
      "icon": "build/biomashine.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/biomashine.png",
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "build/biomashine.icns",
      "category": "public.app-category.healthcare-fitness",
      "identity": null,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "compression": "store",
    "portable": {
      "splashImage": "build/splash.bmp",
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}